generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  games        Game[]
}

model Game {
  userId       Int
  currentLevel Int        @default(1)
  finishTime   DateTime?
  id           Int        @id @default(autoincrement())
  lastUpdated  DateTime   @updatedAt
  startTime    DateTime   @default(now())
  status       GameStatus @default(IN_PROGRESS)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade) // when deletinng User records, delete Game
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}
